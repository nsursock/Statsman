{
  "name": "@scifiui/core",
  "version": "0.1.0",
  "description": "Adaan-styled sci-fi CSS class kit for Tailwind CSS — daisyUI-style, framework-agnostic",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./themes.css": "./src/themes.css",
    "./base.css": "./src/base.css",
    "./components.css": "./src/components.css",
    "./index.css": "./src/index.css",
    "./js": {
      "types": "./src/js/index.d.ts",
      "default": "./src/js/index.js"
    },
    "./js/*": "./src/js/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "gsap": "^3.12.0"
  },
  "keywords": [
    "tailwind",
    "tailwindcss",
    "scifi",
    "ui",
    "daisyui",
    "components",
    "css-variables"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node -e \"console.log('@scifiui/core is CSS+plugin source; no compile step')\""
  }
}
