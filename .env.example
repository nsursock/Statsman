## ──────────────────────────────────────────────────────────────────────────
## Statsman — environment configuration
##
## Copy to .env and adjust. Lines below are commented with sensible defaults;
## uncomment and set the ones you need. Var naming convention:
##
##   STATSMAN_*  — app-specific (mode, secrets, limits, operator seats)
##   PUBLIC_*     — exposed to the browser (SvelteKit convention; safe to ship)
##   RESEND_*     — Resend transactional email
##   STRIPE_*     — Stripe billing
##   SUPABASE_*   — Supabase Auth + Postgres
##   OPENROUTER_* — OpenRouter AI Analyst
##   PG*          — libpq / Postgres discrete connection params (standard)
##   ORIGIN, *_HEADER — SvelteKit adapter-node reverse-proxy headers (standard)
##
## Backward compat: old unprefixed names (DATABASE_PATH, SESSION_SECRET,
## ADMIN_TOKEN, MAIL_FROM, CONTACT_EMAIL, STATSMAN_CONTACT_EMAIL) still work
## as fallbacks. Prefer the prefixed names above for new setups.
## ──────────────────────────────────────────────────────────────────────────


## ── App mode ────────────────────────────────────────────────────────────────
## Two modes:
##   selfhost — customer OSS install: app only (login → dashboard, no billing)
##   cloud    — main product site + Supabase Auth + Stripe (Free → paid tiers)
STATSMAN_MODE=selfhost

## Billing tier (cloud only; selfhost is always free):
##   beta   — cloud is free, one plan, no limits (DEFAULT)
##   normal — Starter ($3) / Indie ($9) / Creator ($19) via Stripe
STATSMAN_BILLING=beta
STATSMAN_BILLING=normal

## Cloud operator seats (comma-separated). These emails get the Founder plan
## — full access, no Stripe. Cloud-only; ignored on selfhost.
STATSMAN_FOUNDER_EMAILS=you@domain.com,cofounder@domain.com


## ── Demo lab ────────────────────────────────────────────────────────────────
## Fake blog at /demo + the landing page tracking itself into "Demo Site".
## Default: on in `npm run dev`, off in prod. Force either way:
STATSMAN_DEMO=1        # enable in prod
STATSMAN_DEMO=0        # disable in dev
## Backfill ~30 days of synthetic traffic on first boot (default: dev only):
STATSMAN_DEMO_SEED=1


## ── Public URL ───────────────────────────────────────────────────────────────
## Public origin used in Auth redirects + Stripe return URLs (no trailing slash).
## When set to a real domain, *.up.railway.app etc. 301-redirect here.
PUBLIC_ORIGIN=http://localhost:5173

## Reverse-proxy headers (adapter-node behind Railway / nginx / Caddy).
## Must match PUBLIC_ORIGIN on the main product service. Prod-only.
ORIGIN=https://statsman.xyz
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=host
ADDRESS_HEADER=x-forwarded-for


## ── Database ─────────────────────────────────────────────────────────────────
## SQLite (self-host default). Ignored when Postgres is configured.
STATSMAN_DATABASE_PATH=./data/statsman.db

## Postgres — option A: single URL (special chars in password must be percent-encoded)
DATABASE_URL=postgres://statsman:statsman@localhost:5432/statsman

## Postgres — option B: discrete params (password as-is, no encoding).
## Do NOT use bare HOST= (that's the HTTP listen address, e.g. :: on Railway).
## If both A and B are set, URL is tried first; on failure we fall back to PG*.
PGHOST=aws-1-eu-west-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.your-project-ref
PGPASSWORD=your-db-password


## ── Security ─────────────────────────────────────────────────────────────────
## Session signing / cookies (required in production).
## Generate with: openssl rand -hex 32
STATSMAN_SESSION_SECRET=dev-change-me

## Protect the self-host dashboard (optional). Leave empty for open local console.
## Generate with: openssl rand -hex 32
STATSMAN_ADMIN_TOKEN=super-secret


## ── Dogfood / first-client tracking ──────────────────────────────────────────
## Inject the tracker on this deploy so the marketing page feeds your dashboard.
## Point PUBLIC_ANALYTICS_ORIGIN at your analytics host; omit to use same origin.
PUBLIC_ANALYTICS_ORIGIN=https://your-statsman.example.com
PUBLIC_ANALYTICS_SITE_ID=your-site-id-here


## ── Email (Resend) ───────────────────────────────────────────────────────────
## Magic-link / transactional email. Optional — Auth confirm/reset use Supabase
## SMTP when these are unset.
RESEND_API_KEY=re_xxx
RESEND_MAIL_FROM=Statsman <auth@your-domain.com>

## Inbound contact address shown on /contact + where contact-form messages go.
## Defaults to hello@statsman.xyz when unset.
RESEND_CONTACT_EMAIL=hello@statsman.xyz


## ── Supabase (cloud Auth + Postgres) ─────────────────────────────────────────
## Same project as Postgres is fine. Enable Email provider in Auth settings.
## Site URL + redirect allow-list: https://your-domain.com/auth/callback, /auth/reset
## For branded templates: Authentication → SMTP (Resend) → paste email-templates/*.html
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # or SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=                    # optional admin


## ── Stripe (cloud billing) ──────────────────────────────────────────────────
## Payment Element on /subscribe + manage on /billing.
## Use pk_test_/sk_test_ locally; pk_live_/sk_live_ in production (never mix).
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_INDIE=price_xxx
STRIPE_PRICE_CREATOR=price_xxx
##
## Live webhook: POST https://YOUR_DOMAIN/api/billing/webhook
## Events: customer.subscription.created|updated|deleted,
##         invoice.paid, invoice.payment_succeeded, invoice_payment.paid


## ── AI Analyst (OpenRouter) ──────────────────────────────────────────────────
## Powers "Explain" (anomaly detection + summary) and "Ask" (natural language Q&A).
## Get a key at https://openrouter.ai/keys
## Without a key, Explain still works (deterministic) but Ask is disabled.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini   # any OpenRouter model slug
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  # optional override
