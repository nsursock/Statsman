# Mode:
#   selfhost — customer install: app only (login → dashboard)
#   hosted   — main product site: marketing + dashboard (no Stripe / magic-link SaaS)
#   cloud    — main product site + multi-user magic-link + Stripe (Free → paid)
STATSMAN_MODE=selfhost

# Demo lab: fake blog at /demo + the landing page tracking itself into "Demo Site".
# Default: on in `npm run dev`, off in prod. Force either way:
# STATSMAN_DEMO=1        # enable in prod
# STATSMAN_DEMO=0        # disable in dev
# Seed the demo site with ~30 days of synthetic traffic (default: dev only):
# STATSMAN_DEMO_SEED=1

# Public URL used in magic links + Stripe return URLs (no trailing slash)
PUBLIC_ORIGIN=http://localhost:5173

# adapter-node behind Railway / any reverse proxy (production HTTPS):
# ORIGIN=https://your-domain.com
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=host
# ADDRESS_HEADER=x-forwarded-for

# SQLite path (self-host). Ignored when Postgres is configured.
DATABASE_PATH=./data/statsman.db

# Postgres — option A: URL (special chars in password must be percent-encoded)
# DATABASE_URL=postgres://statsman:statsman@localhost:5432/statsman

# Postgres — option B: discrete params (password as-is, no encoding). Do NOT use bare HOST=
# (HOST is the HTTP listen address, e.g. :: on Railway).
# If both A and B are set, URL is tried first; on failure we fall back to PG*.
# PGHOST=aws-1-eu-west-1.pooler.supabase.com
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres.your-project-ref
# PGPASSWORD=your-db-password

# Protect self-host dashboard (optional). Leave empty for open local console.
# ADMIN_TOKEN=super-secret

# Session signing / cookies (required in production)
SESSION_SECRET=dev-change-me

# First-client / dogfood: inject tracker on this deploy (marketing site).
# Point ORIGIN at your analytics host; omit ORIGIN to use this same origin.
# PUBLIC_ANALYTICS_ORIGIN=https://your-statsman.example.com
# PUBLIC_ANALYTICS_SITE_ID=your-site-id-here

# Magic-link email (cloud). Without this, login returns a devLink in JSON / logs.
# RESEND_API_KEY=re_xxx
# MAIL_FROM=Statsman <billing@your-domain.com>

# Cloud operator seats (comma-separated). These emails get Founder plan — full access, no Stripe.
# STATSMAN_FOUNDER_EMAILS=you@domain.com

# Billing kill switch. `off` = free cloud beta (no Stripe UI/caps). Flip to `on` when going live.
# STATSMAN_BILLING=off

# Stripe (cloud billing) — Payment Element on /subscribe + manage on /billing
# Use pk_test_/sk_test_ locally; pk_live_/sk_live_ in production (never mix).
# PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_INDIE=price_xxx
# STRIPE_PRICE_CREATOR=price_xxx
#
# Live webhook: POST https://YOUR_DOMAIN/api/billing/webhook
# Events: customer.subscription.created|updated|deleted,
#         invoice.paid, invoice.payment_succeeded, invoice_payment.paid
