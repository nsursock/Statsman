# Mode:
#   selfhost — customer install: app only (login → dashboard)
#   hosted   — main product site: marketing + your dashboard (Railway + Supabase)
#   cloud    — main product site + multi-user magic-link / Stripe
STATSMAN_MODE=selfhost

# Demo lab: fake blog at /demo + the landing page tracking itself into "Demo Site".
# Default: on in `npm run dev`, off in prod. Force either way:
# STATSMAN_DEMO=1        # enable in prod
# STATSMAN_DEMO=0        # disable in dev
# Seed the demo site with ~30 days of synthetic traffic (default: dev only):
# STATSMAN_DEMO_SEED=1

# Public URL used in magic links + Stripe redirects
PUBLIC_ORIGIN=http://localhost:5173

# Behind a reverse proxy, set so getClientAddress()/geoip see the visitor:
# ADDRESS_HEADER=x-forwarded-for

# SQLite path (self-host). Ignored when Postgres is configured.
DATABASE_PATH=./data/statsman.db

# Postgres — option A: URL
# DATABASE_URL=postgres://statsman:statsman@localhost:5432/statsman

# Postgres — option B: discrete params (Supabase pooler). Do NOT use bare HOST=
# (HOST is the HTTP listen address, e.g. :: on Railway).
# PGHOST=aws-1-eu-west-1.pooler.supabase.com
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres.your-project-ref
# PGPASSWORD=your-db-password

# Protect self-host dashboard (optional). Leave empty for open local console.
# ADMIN_TOKEN=super-secret

# Session signing / cookies
SESSION_SECRET=dev-change-me

# First-client / dogfood: inject tracker on this deploy (marketing site).
# Point ORIGIN at your analytics host; omit ORIGIN to use this same origin.
# PUBLIC_ANALYTICS_ORIGIN=https://your-statsman.example.com
# PUBLIC_ANALYTICS_SITE_ID=your-site-id-here

# Magic-link email (cloud). Without this, login returns a devLink in JSON / logs.
# RESEND_API_KEY=re_xxx
# MAIL_FROM=Statsman <onboarding@resend.dev>

# Stripe (cloud billing) — native Payment Element (no hosted Checkout chrome)
# PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_INDIE=price_xxx
# STRIPE_PRICE_CREATOR=price_xxx
